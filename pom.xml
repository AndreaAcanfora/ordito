<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.andreaacanfora</groupId>
  <artifactId>ordito-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>ordito</name>
  <description>Raft for loomkv, tested by a deterministic simulator and a linearizability checker.</description>
  <url>https://github.com/AndreaAcanfora/ordito</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <modules>
    <module>loomkv</module>
    <module>ordito-raft</module>
    <module>ordito-check</module>
    <module>ordito-sim</module>
    <module>ordito-server</module>
    <module>ordito-chaos</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.13.4</junit.version>
    <teavm.version>0.16.0</teavm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.andreaacanfora</groupId>
        <artifactId>ordito-raft</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andreaacanfora</groupId>
        <artifactId>ordito-check</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andreaacanfora</groupId>
        <artifactId>ordito-sim</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andreaacanfora</groupId>
        <artifactId>ordito-server</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andreaacanfora</groupId>
        <artifactId>loomkv</artifactId>
        <version>0.1.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- The browser playground needs TeaVM; built on its own so the main build stays plain JDK. -->
    <profile>
      <id>playground</id>
      <modules>
        <module>ordito-playground</module>
      </modules>
    </profile>
  </profiles>
</project>
